# PKPCare environment template. Copy to .env and fill in. Never commit .env.
# Values marked REQUIRED must be set for the app to work; everything else is optional
# and off by default. Server-only variables must never use the NEXT_PUBLIC_ prefix.
# Per-area details: docs/*.md (auth, scheduling, compliance, notifications, payments,
# interop, telehealth, ai, admin, patient-portal).

# ---------------------------------------------------------------------------
# Appwrite (REQUIRED)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENDPOINT=https://cloud.appwrite.io/v1
PROJECT_ID=your-appwrite-project-id
# Server API key. Needs databases, users, storage and messaging scopes. Server only.
API_KEY=your-appwrite-api-key
DATABASE_ID=your-database-id
PATIENT_COLLECTION_ID=your-patient-collection-id
# Existing collection; scripts/appwrite-setup.mjs adds the new attributes/indexes to it.
APPOINTMENT_COLLECTION_ID=your-appointment-collection-id
NEXT_PUBLIC_BUCKET_ID=your-id-documents-bucket-id

# ---------------------------------------------------------------------------
# Sessions and access (REQUIRED: ADMIN_SESSION_SECRET)
# ---------------------------------------------------------------------------
# HMAC secret signing staff and patient session cookies (also the fallback secret for
# notification links and telehealth rooms). >= 32 chars: openssl rand -base64 48
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# Legacy shared admin passkey. Only used while ALLOW_LEGACY_ADMIN_PASSKEY is not "false".
# Prefer per-staff accounts (node --env-file=.env scripts/create-staff.mjs ...).
ADMIN_PASSKEY=
# Set to "false" once a staff account exists: disables the shared passkey login.
ALLOW_LEGACY_ADMIN_PASSKEY=true
# "true" = patients must sign in with an emailed code before seeing /patients/:userId.
# Needs an Appwrite email provider. Turn on before enabling telehealth with real data.
PATIENT_AUTH_ENFORCED=false
# Public base URL used in emailed/SMS links (confirm, cancel, visit). No trailing slash.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Compliance (REQUIRED in production: FIELD_ENCRYPTION_KEY)
# ---------------------------------------------------------------------------
# AES-256-GCM key for sensitive patient fields: openssl rand -base64 32
# Back it up: losing it makes encrypted fields unreadable. Raise the patients attribute
# sizes first: node --env-file=.env scripts/check-patient-schema.mjs --apply
FIELD_ENCRYPTION_KEY=
# Old key, decrypt-only, during a rotation.
FIELD_ENCRYPTION_KEY_PREVIOUS=
# Bearer secret for /api/cron/* routes (reminders, retention): openssl rand -hex 24
# If unset those routes always answer 401.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Notifications and reminders (optional)
# ---------------------------------------------------------------------------
# sms | email | whatsapp, comma separated (order = fallback order).
NOTIFY_CHANNELS=sms
# fallback = first channel that works; all = send on every channel.
NOTIFY_CHANNELS_MODE=fallback
# "true" also sends a "booking received" message.
NOTIFY_BOOKING_RECEIVED=false
NOTIFY_TIMEOUT_MS=8000
# Signs confirm/cancel/reschedule links. Defaults to ADMIN_SESSION_SECRET.
NOTIFICATION_LINK_SECRET=
REMINDER_CRON_INTERVAL_MINUTES=10
REMINDER_BATCH_SIZE=100
WAITLIST_OFFER_MINUTES=30
# WhatsApp Cloud API (enabled only when both are set; templates need Meta approval).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_PREFIX=
WHATSAPP_TEMPLATE_LANG=en

# ---------------------------------------------------------------------------
# Payments: optional booking deposit via hosted checkout (off by default)
# ---------------------------------------------------------------------------
# none | stripe | razorpay | mock (mock is refused in production).
PAYMENTS_PROVIDER=none
# Minor units (paise/cents). 0 = no deposit.
DEPOSIT_AMOUNT_MINOR=0
DEPOSIT_CURRENCY=INR
DEPOSIT_REFUND_HOURS=24
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK_SECRET=

# ---------------------------------------------------------------------------
# Interoperability: read-only FHIR R4 API (off by default)
# ---------------------------------------------------------------------------
FHIR_API_ENABLED=false
# Comma separated name:scopes:token entries; scopes joined by + or |, tokens >= 32 chars:
#   partner:read:patient+read:appointment:<long-random-token>
FHIR_API_TOKENS=
FHIR_RATE_LIMIT_PER_MINUTE=120
FHIR_BASE_URL=

# ---------------------------------------------------------------------------
# Telehealth (off by default)
# ---------------------------------------------------------------------------
# none | jitsi. Public meet.jit.si has no access control: self-host Jitsi or use JaaS
# before using real patient data.
TELEHEALTH_PROVIDER=none
TELEHEALTH_BASE_URL=https://meet.jit.si
# Defaults to ADMIN_SESSION_SECRET.
TELEHEALTH_ROOM_SECRET=

# ---------------------------------------------------------------------------
# AI assistance (off by default; confirm a BAA/DPA with the provider first)
# ---------------------------------------------------------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Default is a large model; a smaller one is usually enough for routing. Evaluate first.
AI_MODEL=
AI_TIMEOUT_MS=15000
# Shown in the red-flag banner, e.g. 112 or 911. Leave empty for generic wording.
EMERGENCY_NUMBER=
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Build / monitoring (optional)
# ---------------------------------------------------------------------------
# Source-map upload. Without it the Sentry build step is a dry run.
SENTRY_AUTH_TOKEN=
